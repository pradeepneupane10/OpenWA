# Google Apps Script Web App URL
GOOGLE_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Local port for the web dashboard showing the QR code
PORT=3001

# Strict Group Filter (Target WhatsApp group name)
TARGET_GROUP_NAME=Router Changed Thapathali

# Filter keyword
FILTER_KEYWORD=TKT
